{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "uehub",
  "identifier": "dev.uehub.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "uehub",
        "width": 1280,
        "height": 800,
        "minWidth": 1100,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost thumb: http://thumb.localhost",
        "img-src": "'self' blob:",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZFODQzNzdGMTMyMjc0NDgKUldSSWRDSVRmemVFYnF4ZW1sb3BTZ2YzZzZ5bzJkNFFYS0hNaklaSk5CU3FIZWJkU1Bhd3QwNFAK",
      "endpoints": [
        "https://github.com/TON_COMPTE/uehub/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true
    }
  }
}